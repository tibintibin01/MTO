# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.env

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
build/
dist/

# Database
mto_local.db

# Local config — contains user-specific settings, never commit
config.json
server_config.json

# TLS certificates — NEVER commit private keys to version control.
# Generate fresh certs per environment: python backend/generate_certs.py
backend/certs/*.pem
backend/certs/*.key

# IDEs
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Dead code — removed from repo, ignore if present on disk
receipt_generator.py
query_pb.py
utils_legacy.py_bak

# Generated files — logs contain PII (taxpayer names, IPs, audit trails)
logs/
*.log
coverage.xml
.coverage

# Generated PDF documents — never commit receipts or computation PDFs
*.pdf
backend/receipts/
backend/computations/
receipts/
statements/

# Import validation cache — contains taxpayer data, must never be committed
import_cache/

# Archived raw SQL migrations — superseded by Alembic, kept for reference only
# These must never be run against the live DB
migrations/archive/*.sql

# Local frontend environment — contains server IP, varies per deployment
frontend/.env.local
