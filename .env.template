# ==============================================================================
# MTO TREASURY SYSTEM | ENVIRONMENT TEMPLATE
# Copy this file to '.env' and fill in ALL values before running the system.
# NEVER commit the actual '.env' file to version control.
# Generate a secure JWT secret with: python -c "import secrets; print(secrets.token_hex(64))"
# ==============================================================================

# --- AUTHENTICATION ---
# Used by: utils/secrets_manager.py (secrets.jwt_secret) → deps.py (JWT signing)
# Used by: utils/config.py (config.API_SECRET_KEY)
# Both readers resolve this same key — keep them in sync.
MTO_JWT_SECRET=your_super_secret_high_entropy_key_here_min_64_chars

# --- DATABASE ---
# Used by: utils/config.py → backend/database.py (SQLAlchemy connection string)
MTO_DB_HOST=127.0.0.1
MTO_DB_PORT=3306
MTO_DB_USER=mto_app
MTO_DB_PASSWORD=your_secure_db_password
MTO_DB_NAME=mto_treasury

# Root password — only needed for docker-compose, not the app itself
DB_ROOT_PASSWORD=your_secure_root_password

# --- BINARY PATHS ---
# Used by: utils/config.py → backup_service.py (mysqldump for backups)
# On Windows use full paths, e.g. C:/Program Files/MySQL/MySQL Server 8.0/bin/mysql.exe
MTO_MYSQL_PATH=mysql
MTO_MYSQLDUMP_PATH=mysqldump

# Backup output directory — defaults to ~/mto_backups if not set.
# In Docker, mount a volume here: -v /host/backups:/app/backups
MTO_BACKUP_DIR=/path/to/your/backup/directory

# --- SECURITY ---
# Used by: utils/secrets_manager.py → backend/generate_certs.py
MTO_SSL_PASSPHRASE=your_ssl_passphrase_here

# --- API INTEGRATIONS ---
# Used by: utils/secrets_manager.py (secrets.api_key)
# Intended for SMS gateway or third-party integrations
MTO_API_KEY=mto_api_key_v1_xxxxxx

# --- ENVIRONMENT ---
# Used by: utils/config.py — controls production validation strictness
# Used by: utils/secrets_manager.py — controls vault vs .env fallback warnings
# Values: production | staging | development
MTO_ENVIRONMENT=production
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- FEATURE TOGGLES ---
# Used by: utils/__init__.py (FeatureManager) and utils/config.py
MTO_ENABLE_BULK_IMPORT=1
MTO_ENABLE_DELINQUENCY_NOTICES=0
MTO_ENABLE_CLOUD_BACKUP=0
MTO_ENABLE_SENTRY_TELEMETRY=1
MTO_MAINTENANCE_MODE=0

# --- OBSERVABILITY ---
# Used by: backend/main.py (Sentry error tracking — optional)
# Leave blank to disable Sentry
SENTRY_DSN=

# --- GRAFANA ---
# Used by: docker-compose.yml (Grafana admin credentials)
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password

# --- REDIS ---
# Used by: backend/deps.py (WebSocket pub/sub, rate limiter storage)
# Used by: docker-compose.yml (redis service requirepass + api REDIS_URL)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REDIS_PASSWORD=your_secure_redis_password
REDIS_URL=redis://:your_secure_redis_password@localhost:6379

# --- OBJECT STORAGE (S3-Compatible) ---
# Used by: backend/services/storage_service.py
# Set S3_STORAGE_ENABLED=true to upload PDFs to S3/MinIO instead of local disk
S3_STORAGE_ENABLED=false
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=mto-ledgers
S3_REGION_NAME=us-east-1
S3_SECURE=false
