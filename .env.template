# 🏛️ MTO TREASURY SYSTEM | ENVIRONMENT TEMPLATE
# Copy this file to '.env' and fill in the values.
# NEVER commit the actual '.env' file to version control.

# --- AUTHENTICATION ---
# A long, random string used to sign JWT tokens.
MTO_JWT_SECRET=your_super_secret_high_entropy_key_here

# --- DATABASE ---
MTO_DB_PASSWORD=your_secure_db_password

# --- SECURITY ---
# Passphrase for the SSL certificates (if applicable)
MTO_SSL_PASSPHRASE=your_ssl_passphrase_here

# --- API ---
# API Key for third-party integrations (e.g., SMS Gateway)
MTO_API_KEY=mto_api_key_v1_xxxxxx

# --- ENVIRONMENT ---
ENVIRONMENT=production # production, staging, development
LOG_LEVEL=INFO
