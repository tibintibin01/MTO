# ==============================================================================
# MTO TREASURY SYSTEM | ENVIRONMENT TEMPLATE
# Copy this file to '.env' and fill in ALL values before running the system.
# NEVER commit the actual '.env' file to version control.
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_hex(64))"  # JWT / API keys
#   python -c "import secrets; print(secrets.token_hex(24))"  # DB / Redis passwords
# ==============================================================================

# --- AUTHENTICATION ---
# Used by: utils/secrets_manager.py (secrets.jwt_secret) → deps.py (JWT signing)
MTO_JWT_SECRET=your_super_secret_high_entropy_key_here_min_64_chars
MTO_API_SECRET_KEY=your_super_secret_high_entropy_key_here_min_64_chars
SECRET_KEY=your_super_secret_high_entropy_key_here_min_64_chars

# --- DATABASE ---
# SECURITY: The application MUST connect as a least-privilege user, never root.
# Run scripts/create_db_user.sql once (as root/admin) to provision mto_app.
# See scripts/create_db_user.py for an automated setup helper.
#
# Used by: utils/config.py → backend/database.py (SQLAlchemy connection string)
MTO_DB_HOST=127.0.0.1
MTO_DB_PORT=3306
MTO_DB_USER=mto_app
MTO_DB_PASSWORD=your_secure_db_password_min_16_chars
MTO_DB_NAME=property_system

# Root password — used ONLY by docker-compose to initialise the MariaDB container.
# The application itself never uses this value.
DB_ROOT_PASSWORD=your_secure_root_password_min_16_chars

# --- BINARY PATHS ---
# Used by: utils/config.py → backup_service.py (mysqldump for backups)
# On Windows use full paths, e.g. C:/xampp/mysql/bin/mysqldump.exe
MTO_MYSQL_PATH=mysql
MTO_MYSQLDUMP_PATH=mysqldump

# Backup output directory — defaults to ~/mto_backups if not set.
# In Docker, mount a volume here: -v /host/backups:/app/backups
MTO_BACKUP_DIR=/path/to/your/backup/directory

# --- SECURITY ---
# Used by: utils/secrets_manager.py → backend/generate_certs.py
MTO_SSL_PASSPHRASE=your_ssl_passphrase_here

# --- API INTEGRATIONS ---
# Used by: utils/secrets_manager.py (secrets.api_key)
MTO_API_KEY=mto_api_key_v1_xxxxxx

# --- ENVIRONMENT ---
# Values: production | staging | development
# production enforces: non-root DB user, non-empty DB password, strong JWT secret
MTO_ENVIRONMENT=production
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- FEATURE TOGGLES ---
MTO_ENABLE_BULK_IMPORT=1
MTO_ENABLE_DELINQUENCY_NOTICES=0
MTO_ENABLE_CLOUD_BACKUP=0
MTO_ENABLE_SENTRY_TELEMETRY=1
MTO_MAINTENANCE_MODE=0

# --- SCHEDULED BACKUP AUTOMATION ---
# MTO_BACKUP_SCHEDULE: disabled | daily | weekly
# MTO_BACKUP_SCHEDULE_HOUR: 0-23 — hour of day in local server time
# MTO_BACKUP_SCHEDULE_MINUTE: 0-59 — minute within the hour (default 30)
# MTO_BACKUP_SCHEDULE_DAY_OF_WEEK: 0=Monday ... 6=Sunday (only used when weekly)
#
# Recommended: 16:30 (4:30 PM) so backup runs before office closes at 5 PM.
MTO_BACKUP_SCHEDULE=daily
MTO_BACKUP_SCHEDULE_HOUR=16
MTO_BACKUP_SCHEDULE_MINUTE=30
MTO_BACKUP_SCHEDULE_DAY_OF_WEEK=0

# --- OBSERVABILITY ---
# Leave blank to disable Sentry
SENTRY_DSN=

# --- GRAFANA ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password

# --- REDIS ---
REDIS_PASSWORD=your_secure_redis_password
REDIS_URL=redis://:your_secure_redis_password@localhost:6379

# --- OBJECT STORAGE (S3-Compatible) ---
S3_STORAGE_ENABLED=false
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=mto-ledgers
S3_REGION_NAME=us-east-1
S3_SECURE=false
